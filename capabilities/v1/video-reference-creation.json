{
  "$schema": "./manifest.schema.json",
  "id": "video_reference_creation",
  "version": "1.2.0",
  "definition_status": "design_contract",
  "label": "视频参考创作",
  "description": "解析已爆视频为逐集参考剧本，完成分析和改编决策后复用非小说后续链生成新剧本。",
  "kind": "domain_workflow",
  "execution_mode": "stateful_workflow",
  "input_binding": {
    "source_type": "video_reference",
    "asset_role": "primary_source",
    "asset_set_purpose": "video_reference_source"
  },
  "entry_policy": {
    "explicit_invocation": true,
    "auto_route": true,
    "requires_user_confirmation": true,
    "input_collection_modes": [
      "fixed"
    ]
  },
  "routing": {
    "explicit_aliases": [
      "视频参考创作",
      "video_reference_creation"
    ],
    "intent_examples": [
      "解析这部漫剧并参考它创作新剧本",
      "把这些视频转成剧本后做分析和改编"
    ],
    "ambiguity_policy": "ask_user"
  },
  "accepted_asset_kinds": [
    "video"
  ],
  "required_providers": [
    "content_model_provider",
    "multimodal_video_provider",
    "subtitle_ocr_provider",
    "media_processor"
  ],
  "input_schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/input",
  "config_schema_refs": {
    "extraction": "../../schemas/v1/video-reference-creation.schema.json#/$defs/extractionConfig",
    "creation": "../../schemas/v1/video-reference-creation.schema.json#/$defs/creationConfig"
  },
  "default_config_ref": null,
  "default_retry": {
    "automatic_attempts": 1,
    "user_retry_allowed": true,
    "resume_from_cursor": true,
    "retryable_errors": [
      "MODEL_TIMEOUT",
      "MODEL_RATE_LIMIT",
      "PROVIDER_TEMPORARY_FAILURE",
      "PROVIDER_RESPONSE_INVALID",
      "MEDIA_PROCESSING_FAILED",
      "MEDIA_PROBE_FAILED",
      "SUBTITLE_OCR_TIMEOUT",
      "SUBTITLE_OCR_UPLOAD_FAILED",
      "SUBTITLE_OCR_QUERY_FAILED",
      "SUBTITLE_OCR_TASK_FAILED",
      "OUTPUT_REPAIR_FAILED"
    ]
  },
  "context_policy_ref": "context.video_reference_creation.v1",
  "state_contract": {
    "scope": "run",
    "snapshot_schema_ref": "../../schemas/v1/structured-run-state.schema.json",
    "reducer_ref": "structured_state_reducer.v1",
    "max_snapshot_characters": 100000
  },
  "commands": [
    "inspect",
    "start",
    "pause",
    "resume",
    "cancel",
    "retry_failed",
    "approve",
    "edit_artifact",
    "request_ai_revision",
    "regenerate_artifact",
    "inspect_impact",
    "set_episode_execution_mode"
  ],
  "ui": {
    "icon_key": "clapperboard",
    "sort_order": 30,
    "entry_view_key": "video_asset_set",
    "config_view_key": "video_extraction",
    "default_prompt": "请解析我提供的参考视频，并基于解析结果改编生成新的短剧剧本。"
  },
  "completion": {
    "terminal_step_ids": [
      "aggregate_scripts"
    ],
    "required_artifacts": [
      {
        "artifact_type": "script_unit",
        "required_status": "confirmed",
        "coverage": "target_episode_count"
      },
      {
        "artifact_type": "scripts",
        "required_status": "confirmed",
        "coverage": "one"
      }
    ],
    "requires_terminal_approval": false
  },
  "steps": [
    {
      "id": "ingest_source",
      "kind": "system",
      "executor_ref": "runtime.ingest_source",
      "config_ref": "extraction",
      "required_context": [
        "asset_snapshot",
        "config_snapshot"
      ],
      "input_refs": [],
      "output_refs": [
        {
          "artifact_type": "source_input",
          "cardinality": "one",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/common.schema.json#/$defs/sourceInput"
        }
      ],
      "prompt_ref": null,
      "rule_refs": [],
      "approval": {
        "type": "checkpoint",
        "scope": "artifact",
        "required": true,
        "invalidate_on_new_version": true,
        "allowed_actions": [
          "approve"
        ]
      },
      "next": [
        "extract_video_scripts"
      ]
    },
    {
      "id": "extract_video_scripts",
      "kind": "batch",
      "executor_ref": "workflow.video_script_extract",
      "config_ref": "extraction",
      "input_refs": [
        {
          "artifact_type": "source_input",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "sealed_input_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "video_script_unit",
          "cardinality": "many",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/videoScriptUnit"
        }
      ],
      "prompt_ref": "../../design/prompts/video-reference-creation/video-script-extract.v1.md",
      "rule_refs": [
        "../../design/rules/video-reference-creation/video-high-fidelity-script-extraction.v1.md",
        "../../design/rules/shared/transition-flashback-continuity-format.v1.md"
      ],
      "response_adapter_ref": "adapter.legacy_video_script_unit_to_v1",
      "required_context": [
        "asset_snapshot",
        "config_snapshot",
        "continuity_context"
      ],
      "approval": {
        "type": "batch_checkpoint",
        "scope": "batch",
        "required": true,
        "invalidate_on_new_version": true,
        "allowed_actions": [
          "approve",
          "edit_artifact",
          "request_ai_revision",
          "regenerate_artifact"
        ]
      },
      "batch": {
        "item_key": "asset_id",
        "execution": "sequential",
        "failure_policy": "preserve_success_retry_failed",
        "ordering": "natural_episode_order",
        "max_items_per_task": 1,
        "concurrency_policy": "project_serial_global_parallel"
      },
      "state_transition": {
        "mode": "read_write",
        "delta_artifact_type": "video_script_unit",
        "delta_pointer": "/continuity_delta",
        "previous_output_policy": "adjacent",
        "field_mappings": [
          {"delta_field": "new_facts", "state_field": "facts", "operation": "append_unique"},
          {"delta_field": "character_state_changes", "state_field": "character_state", "operation": "append_unique"},
          {"delta_field": "relationship_changes", "state_field": "relationship_state", "operation": "append_unique"},
          {"delta_field": "hooks_opened", "state_field": "open_hooks", "operation": "append_unique"},
          {"delta_field": "hooks_resolved", "state_field": "open_hooks", "operation": "remove"},
          {"delta_field": "hooks_resolved", "state_field": "resolved_hooks", "operation": "append_unique"}
        ]
      },
      "next": [
        "aggregate_reference_scripts"
      ]
    },
    {
      "id": "aggregate_reference_scripts",
      "kind": "aggregate",
      "executor_ref": "runtime.aggregate_reference_scripts",
      "config_ref": "extraction",
      "input_refs": [
        {
          "artifact_type": "video_script_unit",
          "cardinality": "many",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "reference_scripts",
          "cardinality": "one",
          "initial_status": "confirmed",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/referenceScripts"
        }
      ],
      "prompt_ref": null,
      "rule_refs": [],
      "approval": {
        "type": "none",
        "required": false,
        "invalidate_on_new_version": false
      },
      "next": [
        "analyze_reference_scripts"
      ]
    },
    {
      "id": "analyze_reference_scripts",
      "kind": "model",
      "executor_ref": "worker.structured_content",
      "config_ref": "extraction",
      "input_refs": [
        {
          "artifact_type": "reference_scripts",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "video_script_unit",
          "cardinality": "many",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "script_analysis",
          "cardinality": "one",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/scriptAnalysis"
        }
      ],
      "prompt_ref": "../../design/prompts/video-reference-creation/script-analysis.v1.md",
      "response_adapter_ref": "adapter.video_script_analysis_identity_v1",
      "quality_review_routes": [
        "source_analysis"
      ],
      "rule_refs": [
        "../../design/rules/video-reference-creation/script-analysis.v1.md"
      ],
      "required_context": [
        "approval_snapshot",
        "config_snapshot",
        "continuity_context"
      ],
      "approval": {
        "type": "checkpoint",
        "required": true,
        "invalidate_on_new_version": true
      },
      "next": [
        "propose_adaptation_options"
      ]
    },
    {
      "id": "propose_adaptation_options",
      "kind": "model",
      "executor_ref": "worker.structured_content",
      "config_ref": null,
      "input_refs": [
        {
          "artifact_type": "script_analysis",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "adaptation_options",
          "cardinality": "one",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/adaptationOptions"
        }
      ],
      "prompt_ref": "../../design/prompts/video-reference-creation/adaptation-options.v1.md",
      "response_adapter_ref": "adapter.video_adaptation_options_identity_v1",
      "rule_refs": [
        "../../design/rules/video-reference-creation/no-copy-adaptation.v1.md"
      ],
      "required_context": [
        "approval_snapshot",
        "user_instruction"
      ],
      "approval": {
        "type": "transition_checkpoint",
        "scope": "transition",
        "required": true,
        "invalidate_on_new_version": true,
        "condition": null,
        "allowed_actions": [
          "select_adaptation_strategy",
          "request_ai_revision"
        ]
      },
      "next": [
        {
          "when": "adaptation_selection_and_creation_config_confirmed",
          "to": "build_adaptation_brief"
        }
      ]
    },
    {
      "id": "build_adaptation_brief",
      "kind": "model",
      "executor_ref": "worker.structured_content",
      "config_ref": "creation",
      "input_refs": [
        {
          "artifact_type": "script_analysis",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "adaptation_options",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "adaptation_brief",
          "cardinality": "one",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/adaptationBrief"
        }
      ],
      "prompt_ref": "../../design/prompts/video-reference-creation/adaptation-brief.v1.md",
      "response_adapter_ref": "adapter.video_adaptation_brief_identity_v1",
      "rule_refs": [
        "../../design/rules/video-reference-creation/no-copy-adaptation.v1.md"
      ],
      "required_context": [
        "decision_snapshot",
        "user_instruction",
        "approval_snapshot",
        "config_snapshot"
      ],
      "approval": {
        "type": "checkpoint",
        "required": true,
        "invalidate_on_new_version": true
      },
      "next": [
        "build_story_seed"
      ]
    },
    {
      "id": "build_story_seed",
      "kind": "shared_workflow",
      "executor_ref": "workflow.non_novel_story_seed",
      "config_ref": "creation",
      "input_refs": [
        {
          "artifact_type": "adaptation_brief",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "script_analysis",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "story_seed",
          "cardinality": "one",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/storySeed"
        }
      ],
      "prompt_ref": "../../design/prompts/video-reference-creation/story-seed.v1.md",
      "rule_refs": [
        "../../design/rules/shared/character-relationships-voice.v1.md",
        "../../design/rules/shared/structure-hook-conflict-payoff-cliffhanger.v1.md",
        "../../design/rules/shared/non-novel-material-story-seed.v1.md",
        "../../design/rules/video-reference-creation/no-copy-adaptation.v1.md"
      ],
      "response_adapter_ref": "adapter.legacy_video_story_seed_to_v1",
      "quality_review_routes": [
        "story_bible"
      ],
      "required_context": [
        "approval_snapshot",
        "config_snapshot",
        "continuity_context"
      ],
      "approval": {
        "type": "checkpoint",
        "required": true,
        "invalidate_on_new_version": true
      },
      "next": [
        "build_series_blueprint"
      ]
    },
    {
      "id": "build_series_blueprint",
      "kind": "shared_workflow",
      "executor_ref": "workflow.non_novel_series_blueprint",
      "config_ref": "creation",
      "input_refs": [
        {
          "artifact_type": "story_seed",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "adaptation_brief",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "series_blueprint",
          "cardinality": "one",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/seriesBlueprint"
        }
      ],
      "prompt_ref": "../../design/prompts/non-novel-to-script/series-blueprint.v1.md",
      "rule_refs": [
        "../../design/rules/shared/structure-hook-conflict-payoff-cliffhanger.v1.md",
        "../../design/rules/shared/miniprogram-short-drama.v1.md",
        "../../design/rules/video-reference-creation/no-copy-adaptation.v1.md"
      ],
      "response_adapter_ref": "adapter.legacy_video_series_blueprint_to_v1",
      "required_context": [
        "approval_snapshot",
        "config_snapshot",
        "continuity_context"
      ],
      "approval": {
        "type": "checkpoint",
        "required": true,
        "invalidate_on_new_version": true
      },
      "next": [
        "build_episode_cards"
      ]
    },
    {
      "id": "build_episode_cards",
      "kind": "batch",
      "executor_ref": "workflow.episode_cards",
      "config_ref": "creation",
      "input_refs": [
        {
          "artifact_type": "series_blueprint",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "adaptation_brief",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "episode_cards",
          "cardinality": "one",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/episodeCards"
        }
      ],
      "prompt_ref": "../../design/prompts/non-novel-to-script/episode-cards.v1.md",
      "provider_result_schema_ref": "../../schemas/v1/non-novel-to-script.schema.json#/$defs/episodeCardsProviderResult",
      "rule_refs": [
        "../../design/rules/shared/structure-hook-conflict-payoff-cliffhanger.v1.md",
        "../../design/rules/shared/transition-flashback-continuity-format.v1.md",
        "../../design/rules/shared/miniprogram-short-drama.v1.md",
        "../../design/rules/video-reference-creation/no-copy-adaptation.v1.md"
      ],
      "response_adapter_ref": "adapter.legacy_video_episode_cards_to_v1",
      "quality_review_routes": [
        "episode_plan"
      ],
      "required_context": [
        "approval_snapshot",
        "config_snapshot",
        "continuity_context"
      ],
      "approval": {
        "type": "batch_checkpoint",
        "required": true,
        "invalidate_on_new_version": true
      },
      "batch": {
        "item_key": "episode_no",
        "execution": "sequential",
        "failure_policy": "preserve_success_retry_failed",
        "ordering": "natural_episode_order",
        "max_items_per_task": 5,
        "concurrency_policy": "episode_cards_default"
      },
      "state_transition": {
        "mode": "read_write",
        "delta_artifact_type": "episode_cards",
        "delta_pointer": "/continuity_delta",
        "previous_output_policy": "adjacent",
        "field_mappings": [
          {"delta_field": "new_facts", "state_field": "facts", "operation": "append_unique"},
          {"delta_field": "character_state_changes", "state_field": "character_state", "operation": "append_unique"},
          {"delta_field": "relationship_changes", "state_field": "relationship_state", "operation": "append_unique"},
          {"delta_field": "hooks_opened", "state_field": "open_hooks", "operation": "append_unique"},
          {"delta_field": "hooks_resolved", "state_field": "open_hooks", "operation": "remove"},
          {"delta_field": "hooks_resolved", "state_field": "resolved_hooks", "operation": "append_unique"}
        ]
      },
      "next": [
        "build_script_contexts"
      ]
    },
    {
      "id": "build_script_contexts",
      "kind": "system",
      "executor_ref": "runtime.build_script_contexts",
      "config_ref": "creation",
      "input_refs": [
        {
          "artifact_type": "adaptation_brief",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "story_seed",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "series_blueprint",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "episode_cards",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "script_context",
          "cardinality": "many",
          "initial_status": "confirmed",
          "schema_ref": "../../schemas/v1/video-reference-creation.schema.json#/$defs/scriptContext"
        }
      ],
      "prompt_ref": null,
      "rule_refs": [],
      "response_adapter_ref": "adapter.video_script_context_to_v1",
      "required_context": [
        "approval_snapshot",
        "config_snapshot",
        "continuity_context"
      ],
      "visibility": "internal",
      "approval": {
        "type": "none",
        "required": false,
        "invalidate_on_new_version": false
      },
      "next": [
        "generate_script_units"
      ]
    },
    {
      "id": "generate_script_units",
      "kind": "shared_workflow",
      "executor_ref": "workflow.shared_script_generation",
      "config_ref": "creation",
      "input_refs": [
        {
          "artifact_type": "episode_cards",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "adaptation_brief",
          "cardinality": "one",
          "required_status": "confirmed",
          "version_policy": "approval_snapshot"
        },
        {
          "artifact_type": "script_context",
          "cardinality": "many",
          "required_status": "confirmed",
          "version_policy": "exact"
        }
      ],
      "output_refs": [
        {
          "artifact_type": "script_unit",
          "cardinality": "many",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/common.schema.json#/$defs/scriptUnit"
        },
        {
          "artifact_type": "script_handoff",
          "cardinality": "many",
          "initial_status": "pending_approval",
          "schema_ref": "../../schemas/v1/common.schema.json#/$defs/scriptHandoff"
        }
      ],
      "prompt_ref": "../../design/prompts/shared/script-generate.v1.md",
      "rule_refs": [
        "../../design/rules/shared/script-writing.v1.md",
        "../../design/rules/shared/dialogue.v1.md",
        "../../design/rules/shared/transition-flashback-continuity-format.v1.md",
        "../../design/rules/shared/miniprogram-short-drama.v1.md",
        "../../design/rules/video-reference-creation/no-copy-adaptation.v1.md"
      ],
      "response_adapter_ref": "adapter.legacy_script_unit_to_v1",
      "quality_review_routes": [
        "script_generation",
        "user"
      ],
      "required_context": [
        "approval_snapshot",
        "config_snapshot",
        "continuity_context"
      ],
      "approval": {
        "type": "batch_checkpoint",
        "required": true,
        "invalidate_on_new_version": true
      },
      "batch": {
        "item_key": "episode_no",
        "execution": "sequential",
        "failure_policy": "preserve_success_retry_failed",
        "ordering": "natural_episode_order",
        "max_items_per_task": 1,
        "concurrency_policy": "script_continuity_sequential"
      },
      "state_transition": {
        "mode": "read_write",
        "delta_artifact_type": "script_handoff",
        "delta_pointer": "/continuity_delta",
        "previous_output_policy": "adjacent",
        "field_mappings": [
          {"delta_field": "new_facts", "state_field": "facts", "operation": "append_unique"},
          {"delta_field": "character_state_changes", "state_field": "character_state", "operation": "append_unique"},
          {"delta_field": "relationship_changes", "state_field": "relationship_state", "operation": "append_unique"},
          {"delta_field": "hooks_opened", "state_field": "open_hooks", "operation": "append_unique"},
          {"delta_field": "hooks_resolved", "state_field": "open_hooks", "operation": "remove"},
          {"delta_field": "hooks_resolved", "state_field": "resolved_hooks", "operation": "append_unique"}
        ]
      },
      "next": [
        "review_script_set"
      ]
    },
    {
