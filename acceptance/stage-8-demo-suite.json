{
  "contract_version": "1.0.0",
  "status": "test_plan",
  "target": "internal_interactive_demo",
  "source_matrix": "./stage-2-matrix.json",
  "result_template": "./stage-9-demo-result.template.json",
  "environments": [
    {
      "id": "local_compile_only",
      "purpose": "合同、前端和 Go 编译门禁",
      "can_execute_go_binaries": false,
      "blocker": "企业 WDAC 拒绝新生成且未签名的 Go 可执行文件"
    },
    {
      "id": "trusted_demo_runtime",
      "purpose": "确定性 Runtime、API、浏览器 E2E 和重启恢复",
      "can_execute_go_binaries": true,
      "requirements": [
        "可运行当前源码构建的 Server",
        "可使用独立临时 SQLite 和 Blob 目录",
        "可运行 Node.js 浏览器自动化",
        "测试完成后删除临时凭据和媒体副本"
      ]
    },
    {
      "id": "real_provider_demo",
      "purpose": "三条真实生成链和内容质量抽查",
      "can_execute_go_binaries": true,
      "requirements": [
        "服务端注入模型和 MediaKit 凭据",
        "凭据不写入源码、数据库、浏览器或测试报告",
        "记录 Provider、Model Variant、Fixture 哈希和调用时间"
      ]
    }
  ],
  "suites": [
    {
      "id": "completed_design_contracts",
      "blocking": false,
      "selector": { "required_by": "stage2_design" },
      "expected_case_count": 6
    },
    {
      "id": "demo_automated_blocking",
      "blocking": true,
      "selector": { "required_by": "implementation", "priority": "P0" },
      "expected_case_count": 65
    },
    {
      "id": "demo_nonblocking",
      "blocking": false,
      "selector": { "required_by": "implementation", "priority": "P1" },
      "expected_case_count": 1
    },
    {
      "id": "demo_real_sample_and_manual",
      "blocking": true,
      "case_ids": [
        "SHELL-004",
        "UI-006",
        "NOVEL-001",
        "NOVEL-002",
        "NOVEL-003",
        "NOVEL-004",
        "NON-001",
        "NON-002",
        "VIDEO-001",
        "VIDEO-002",
