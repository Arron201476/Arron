    }
  ],
  "stage9_entry_gate": {
    "required": [
      "测试套件机器校验通过",
      "Go 全量编译和 Runtime 测试编译通过",
      "前端单测与生产构建通过",
      "Capability 合同校验通过",
      "受信 Demo Runtime 环境可用",
      "真实小说、非小说和视频样本位置与授权明确"
    ]
  },
  "stage9_exit_rule": {
    "allowed_results": ["pass", "fail", "blocked", "not_run"],
    "pass_condition": "所有 blocking 套件 P0 用例为 pass，P1 缺陷有负责人和期限，三条真实链均形成最终剧本 Candidate。",
    "forbidden_shortcuts": [
      "blocked 或 not_run 计为 pass",
      "用编译通过替代 Runtime 执行",
      "用 Mock Provider 替代真实内容抽查",
      "用单集视频替代多集排序、聚合和改编确认"
    ]
  }
}
