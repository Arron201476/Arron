        "VIDEO-008",
        "VIDEO-009",
        "SEC-003",
        "SEC-004",
        "NFR-002",
        "NFR-003"
      ],
      "expected_case_count": 17
    },
    {
      "id": "deferred_formal_release",
      "blocking": false,
      "case_ids": [
        "API-005",
        "SSE-004",
        "MIG-001",
        "MIG-002",
        "MIG-003",
        "MIG-004",
