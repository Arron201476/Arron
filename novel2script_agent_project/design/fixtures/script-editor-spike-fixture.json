          "time_of_day": "夜",
          "lines": [
            {
              "line_id": "ln_001_001_001",
              "block_type": "action",
              "text": "雨声压过远处钟鼓。女主跪在殿阶下，袖中握着碎玉。",
              "marks": []
            },
            {
              "line_id": "ln_001_001_002",
              "block_type": "dialogue",
              "speaker": "女主",
              "text": "三年冷宫，我等的不是回去，是让你们亲手开门。",
              "marks": [
