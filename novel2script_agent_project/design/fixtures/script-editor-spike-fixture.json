          ]
        },
        {
          "scene_id": "sc_001_002",
          "scene_no": 2,
          "title": "贵妃册封殿",
          "location": "正殿",
          "time_of_day": "晨",
          "lines": [
            {
              "line_id": "ln_001_002_001",
              "block_type": "action",
              "text": "贵妃抬手，所有宫人跪下。女主没有低头。",
              "marks": []
