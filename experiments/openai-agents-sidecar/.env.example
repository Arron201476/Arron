CONTENT_AGENT_SIDECAR_HOST=127.0.0.1
CONTENT_AGENT_SIDECAR_PORT=8871
CONTENT_AGENT_BACKEND_BASE_URL=http://127.0.0.1:8860

# The control-model gateway must support /responses and /responses/compact.
# The endpoint may be the API root or a full /chat/completions URL.
CONTENT_AGENT_CONTROL_MODEL_ENDPOINT=
CONTENT_AGENT_CONTROL_MODEL_API_KEY=
CONTENT_AGENT_CONTROL_MODEL_MODEL=
CONTENT_AGENT_CONTROL_MODEL_TIMEOUT_SECONDS=180
CONTENT_AGENT_CONTROL_MODEL_MAX_OUTPUT_TOKENS=16384
CONTENT_AGENT_SIDECAR_MODEL_MAX_RETRIES=2
CONTENT_AGENT_SIDECAR_RUN_TIMEOUT_SECONDS=210
CONTENT_AGENT_SIDECAR_VIDEO_TASK_TIMEOUT_SECONDS=1200
CONTENT_AGENT_VIDEO_MODEL_MAX_RETRIES=0
CONTENT_AGENT_VIDEO_MODEL_STREAM=true
CONTENT_AGENT_SIDECAR_INTERNAL_TOKEN=
CONTENT_AGENT_SIDECAR_SESSION_DB_PATH=.tmp/openai-agents-sidecar-sessions.db
CONTENT_AGENT_RELEASE_ID=dev

# Tracing may be enabled, but model/tool payloads and sensitive trace data stay
# disabled unless a separately reviewed environment intentionally overrides it.
CONTENT_AGENT_SIDECAR_TRACING=false
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
