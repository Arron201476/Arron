# Copy to .env.local for local development. Never commit populated secrets.
# Required for every non-loopback listener. The JSON file stores SHA-256 token
# digests only; see docs/identity-and-multitenancy.md and auth.example.json.
CONTENT_AGENT_AUTH_CONFIG_PATH=

CONTENT_AGENT_CONTROL_MODEL_ENDPOINT=
CONTENT_AGENT_CONTROL_MODEL_API_KEY=
CONTENT_AGENT_CONTROL_MODEL_MODEL=
CONTENT_AGENT_CONTROL_MODEL_TIMEOUT_SECONDS=180
CONTENT_AGENT_CONTROL_MODEL_MAX_OUTPUT_TOKENS=16384
CONTENT_AGENT_CONTROL_MODEL_JSON_MODE=false
CONTENT_AGENT_CONTROL_MODEL_STREAM=false

# Required OpenAI Agents SDK runtime. The Go server has no legacy Agent
# fallback and refuses message execution when the Sidecar is unavailable.
CONTENT_AGENT_OPENAI_SIDECAR_URL=
CONTENT_AGENT_OPENAI_SIDECAR_TIMEOUT_SECONDS=420
CONTENT_AGENT_SIDECAR_INTERNAL_TOKEN=

# Fail-closed rollout controls. Use a comma-separated workspace allowlist for
# canary mode; leave it empty to enable all workspaces. Disabling the flag does
# not route traffic to a legacy Agent.
CONTENT_AGENT_SDK_AGENT_ENABLED=true
CONTENT_AGENT_SDK_CANARY_WORKSPACES=
CONTENT_AGENT_RELEASE_ID=dev

# Sidecar privacy defaults are already enforced in code. These explicit values
# document the required production posture.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1

# Skill scripts are disabled when both values below are empty. Configure them
# together only with an absolute docker/podman executable and a digest-pinned,
# preloaded Python image. The sandbox uses --pull=never and never falls back to
# executing uploaded code on the host. Adapter defaults to the host OS.
CONTENT_AGENT_SCRIPT_SANDBOX_ADAPTER=
CONTENT_AGENT_SCRIPT_OCI_COMMAND=
CONTENT_AGENT_SCRIPT_PYTHON_IMAGE=

CONTENT_AGENT_CONTENT_MODEL_ENDPOINT=
CONTENT_AGENT_CONTENT_MODEL_API_KEY=
CONTENT_AGENT_CONTENT_MODEL_MODEL=
CONTENT_AGENT_CONTENT_MODEL_TIMEOUT_SECONDS=240
CONTENT_AGENT_CONTENT_MODEL_MAX_OUTPUT_TOKENS=65536
CONTENT_AGENT_CONTENT_MODEL_JSON_MODE=false
CONTENT_AGENT_CONTENT_MODEL_STREAM=false

CONTENT_AGENT_VIDEO_MODEL_ENDPOINT=
CONTENT_AGENT_VIDEO_MODEL_API_KEY=
CONTENT_AGENT_VIDEO_MODEL_MODEL=
CONTENT_AGENT_VIDEO_MODEL_TIMEOUT_SECONDS=300
CONTENT_AGENT_VIDEO_MODEL_MAX_OUTPUT_TOKENS=65535
CONTENT_AGENT_VIDEO_MODEL_JSON_MODE=true
CONTENT_AGENT_VIDEO_MODEL_STREAM=false

CONTENT_AGENT_IMAGE_MODEL_ENDPOINT=
CONTENT_AGENT_IMAGE_MODEL_API_KEY=
CONTENT_AGENT_IMAGE_MODEL_MODEL=
CONTENT_AGENT_IMAGE_MODEL_TIMEOUT_SECONDS=180
CONTENT_AGENT_VIDEO_MAX_DURATION_SECONDS=300
CONTENT_AGENT_IMAGE_MODEL_MAX_OUTPUT_TOKENS=16384
CONTENT_AGENT_IMAGE_MODEL_JSON_MODE=false
CONTENT_AGENT_IMAGE_MODEL_STREAM=false

CONTENT_AGENT_MEDIAKIT_API_KEY=
CONTENT_AGENT_MEDIAKIT_ENDPOINT=https://mediakit.cn-beijing.volces.com
CONTENT_AGENT_MEDIAKIT_POLL_INTERVAL=2s

# Stateful workflow model execution belongs to the Agents SDK Sidecar. Go only
# leases attempts and validates/commits results; there is no Go model worker.
CONTENT_AGENT_SIDECAR_TASK_WORKER_ENABLED=true
CONTENT_AGENT_SIDECAR_TASK_WORKER_CONCURRENCY=4
CONTENT_AGENT_SIDECAR_TASK_WORKER_POLL_MILLISECONDS=500
CONTENT_AGENT_SIDECAR_TASK_WORKER_LEASE_SECONDS=1500

# Required host tools. Use absolute paths in a deployment environment.
CONTENT_AGENT_FFMPEG_COMMAND=
CONTENT_AGENT_FFPROBE_COMMAND=
CONTENT_AGENT_PDF_PARSER_COMMAND=

# Opt-in real gateway smoke test. Never commit a populated API key.
CONTENT_AGENT_MEDIAKIT_GATEWAY_SMOKE=0
CONTENT_AGENT_MEDIAKIT_VIDEO_FIXTURE=
CONTENT_AGENT_MEDIAKIT_SMOKE_OUTPUT=
