{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-agent.internal/schemas/v1/script-continuation.schema.json",
  "title": "Script Continuation Capability Schemas",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "source_type", "assets", "user_request_message_id"],
      "properties": {
        "project_id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "source_type": {"const": "script"},
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/assetInputRef"}
        },
        "user_request_message_id": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "user_notes": {"$ref": "common.schema.json#/$defs/stringList"}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_length_chars"],
      "properties": {
        "target_length_chars": {"type": "integer", "minimum": 1000, "maximum": 50000}
      }
    },
    "scriptStyleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_pattern", "dialogue_style", "scene_rhythm"],
      "properties": {
        "format_pattern": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "dialogue_style": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "scene_rhythm": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "characterSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "personality_and_identity", "current_status", "core_motive"],
      "properties": {
        "name": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "personality_and_identity": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "current_status": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "core_motive": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "coreSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldview", "story_synopsis", "continuation_anchor", "script_style_profile", "character_settings"],
      "properties": {
        "worldview": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "story_synopsis": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "continuation_anchor": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "script_style_profile": {"$ref": "#/$defs/scriptStyleProfile"},
        "character_settings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/characterSetting"}
        }
      }
    },
    "continuationOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "title", "genre_tag", "summary", "outline"],
      "properties": {
        "option_id": {"type": "string", "pattern": "^option_[1-5]$"},
        "title": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "genre_tag": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "summary": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "outline": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "continuationOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_settings", "options", "selection_instructions"],
      "properties": {
        "core_settings": {"$ref": "#/$defs/coreSettings"},
        "options": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/continuationOption"}
        },
        "selection_instructions": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    },
    "continuationScript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "selected_option_id", "script_text"],
      "properties": {
        "title": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "selected_option_id": {"type": "string", "pattern": "^option_[1-5]$"},
        "script_text": {"$ref": "common.schema.json#/$defs/nonEmptyString"}
      }
    }
  }
}
