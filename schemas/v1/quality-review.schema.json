{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-agent.internal/schemas/v1/quality-review.schema.json",
  "title": "Script Quality Review Result",
  "$ref": "#/$defs/result",
  "$defs": {
    "severity": {
      "enum": [
        "blocker",
        "high",
        "medium",
        "low"
      ]
    },
    "recommendedRoute": {
      "enum": [
        "source_analysis",
        "story_bible",
        "episode_plan",
        "script_generation",
        "user"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "severity",
        "episode_nos",
        "category",
        "evidence",
        "impact",
        "must_preserve",
        "revision_target",
        "recommended_route"
      ],
      "properties": {
        "issue_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "episode_nos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "scene_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "must_preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision_target": {
          "type": "string",
          "minLength": 1
        },
        "recommended_route": {
          "$ref": "#/$defs/recommendedRoute"
        }
      }
    },
    "issueCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker",
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "blocker": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_version",
        "input_snapshot_hash",
        "scope",
        "issue_counts",
        "issues",
        "recommended_route",
        "affected_episode_nos"
      ],
      "properties": {
        "review_version": {
          "type": "integer",
          "minimum": 1
        },
        "input_snapshot_hash": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "full_script",
            "impacted_scope"
          ]
        },
        "issue_counts": {
          "$ref": "#/$defs/issueCounts"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "recommended_route": {
          "oneOf": [
            {
              "$ref": "#/$defs/recommendedRoute"
            },
            {
              "type": "null"
            }
          ]
        },
        "affected_episode_nos": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "summary": {
          "type": "string"
        },
        "diagnostic_scores": {
          "type": "object"
        },
        "compliance_status": {
          "enum": [
            "not_requested",
            "NEEDS_POLICY"
          ]
        }
      }
    }
  }
}
