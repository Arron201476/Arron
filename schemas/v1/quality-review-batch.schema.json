{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-agent.internal/schemas/v1/quality-review-batch.schema.json",
  "title": "Script Quality Review Batch Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_snapshot_hash",
    "episode_start",
    "episode_end",
    "issues",
    "episode_summaries"
  ],
  "properties": {
    "input_snapshot_hash": { "type": "string", "minLength": 1 },
    "episode_start": { "type": "integer", "minimum": 1 },
    "episode_end": { "type": "integer", "minimum": 1 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id", "severity", "episode_nos", "category", "evidence",
          "impact", "must_preserve", "revision_target", "recommended_route"
        ],
        "properties": {
          "issue_id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocker", "high", "medium", "low"] },
          "episode_nos": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          },
          "scene_refs": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "must_preserve": { "type": "array", "items": { "type": "string" } },
          "revision_target": { "type": "string", "minLength": 1 },
          "recommended_route": {
            "enum": ["source_analysis", "story_bible", "episode_plan", "script_generation", "user"]
          }
        }
      }
    },
    "episode_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["episode_no", "status", "summary"],
        "properties": {
          "episode_no": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["passed", "issues_found"] },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
