{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_episode_count"],
  "properties": {
    "target_episode_count": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 3},
    "review_depth": {"type": "string", "enum": ["concise", "standard", "deep"], "default": "standard"}
  }
}
