{
  "$schema": "./manifest.schema.json",
  "id": "episode_review_workflow",
  "version": "1.0.0",
  "definition_status": "design_contract",
  "label": "Episode Review Workflow",
  "description": "Produce one review per episode, then approve the exact report versions together.",
  "kind": "domain_workflow",
  "execution_mode": "stateful_workflow",
  "input_binding": {"source_type": "story", "asset_role": "primary_source"},
  "entry_policy": {"explicit_invocation": true, "auto_route": false, "requires_user_confirmation": true, "input_collection_modes": ["fixed"]},
  "routing": {"explicit_aliases": ["episode review workflow"], "intent_examples": ["Review each supplied episode."], "ambiguity_policy": "ask_user"},
  "accepted_asset_kinds": ["text", "document"],
  "required_providers": ["content_model_provider"],
  "input_schema_ref": "../schemas/input.json",
  "config_schema_refs": {"review": "../schemas/config.json"},
  "default_config_ref": "review",
  "default_retry": {"automatic_attempts": 1, "user_retry_allowed": true, "resume_from_cursor": true, "retryable_errors": ["MODEL_TIMEOUT"]},
  "context_policy_ref": "context.generic_skill_workflow.v1",
  "commands": ["inspect", "start", "pause", "resume", "cancel", "approve"],
  "ui": {"icon_key": "clipboard_check", "sort_order": 910, "entry_view_key": "source_materials", "config_view_key": "json_schema"},
  "completion": {"terminal_step_ids": ["review_episodes"], "required_artifacts": [{"artifact_type": "generic_document", "required_status": "confirmed", "coverage": "target_episode_count"}], "requires_terminal_approval": false},
  "steps": [{
    "id": "review_episodes",
    "kind": "batch",
    "executor_ref": "worker.structured_content",
    "config_ref": "review",
    "required_context": ["asset_snapshot", "config_snapshot"],
    "input_refs": [],
    "output_refs": [{"artifact_type": "generic_document", "cardinality": "many", "initial_status": "pending_approval", "schema_ref": "../schemas/result.json"}],
    "prompt_ref": "../prompts/review.md",
    "rule_refs": [],
    "batch": {"item_key": "episode_no", "execution": "parallel", "ordering": "natural_episode_order", "max_items_per_task": 1, "failure_policy": "preserve_success_retry_failed"},
    "approval": {"type": "batch_checkpoint", "scope": "batch", "required": true, "invalidate_on_new_version": true, "allowed_actions": ["approve", "edit_artifact", "request_ai_revision", "regenerate_artifact"]},
    "next": []
  }]
}
